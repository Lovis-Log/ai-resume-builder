# Neon Postgres
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/db?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Neon Realtime
NEON_REALTIME_URL=wss://ep-xxx.rt.us-east-1.aws.neon.tech/
NEON_REALTIME_SECRET=replace-with-the-branch-realtime-secret
NEXT_PUBLIC_NEON_REALTIME_URL=$NEON_REALTIME_URL

# DeepSeek (direct)
# Without a key, AI actions use deterministic local heuristics.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing (manual until a provider is connected)
BILLING_PROVIDER=manual
# BILLING_WEBHOOK_SECRET=
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
